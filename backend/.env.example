# ---------------------------------------------------------------------------
# Backend environment configuration
# Copy this file to ".env" and fill in the password, then never commit .env.
# ---------------------------------------------------------------------------

# Database connection (the API connects as the READ-ONLY role, not postgres)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=healthcare_accessibility
DB_USER=gis_readonly
DB_PASSWORD=readonly_pass_change_me

# asyncpg connection-pool sizing
DB_POOL_MIN=2
DB_POOL_MAX=10

# CORS — comma-separated list of allowed frontend origins (React dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API metadata
API_TITLE=Healthcare Accessibility Web GIS API
API_VERSION=1.0.0
